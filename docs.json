{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lemonado",
  "description": "Simple guides for getting useful marketing work done with Lemonado.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Manrope"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/lemonado-favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "icon": "compass",
        "pages": [
          "index",
          "why-lemonado",
          "getting-started",
          "workspace-tour"
        ]
      },
      {
        "group": "Use Lemonado",
        "icon": "mouse-pointer-2",
        "pages": [
          "ask-lemonado",
          "work-together",
          "connectors",
          "brand-and-memory",
          "creatives",
          "studio",
          "skills",
          "routines",
          "team-channels",
          "external-ai",
          "mcp-reference"
        ]
      },
      {
        "group": "For agencies",
        "icon": "briefcase-business",
        "pages": [
          "agencies",
          "portal"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://lemonado.io"
      },
      {
        "label": "Support",
        "href": "mailto:support@lemonado.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Lemonado",
      "href": "https://app.lemonado.io"
    }
  },
  "contextual": {
    "options": []
  },
  "redirects": [
    { "source": "/tasks", "destination": "/routines" },
    { "source": "/introduction", "destination": "/" },
    { "source": "/quickstart", "destination": "/getting-started" },
    { "source": "/connecting-data", "destination": "/connectors" },
    { "source": "/workspaces", "destination": "/workspace-tour" },
    { "source": "/features/chat", "destination": "/ask-lemonado" },
    { "source": "/features/studio", "destination": "/studio" },
    { "source": "/features/creative-analytics", "destination": "/creatives" },
    { "source": "/features/agents", "destination": "/routines" },
    { "source": "/integrations/:path*", "destination": "/connectors" },
    { "source": "/features/mcp", "destination": "/mcp-reference" },
    { "source": "/ai-connectors/:path*", "destination": "/external-ai" },
    { "source": "/resources/prompt-library", "destination": "/ask-lemonado" }
  ]
}
